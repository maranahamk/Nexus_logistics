{
  "name": "nexus-logistics",
  "version": 2,
  "domains": [
    "nexus-logistics.run"
  ],
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "booking.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "/booking.html" }
  ]
}
